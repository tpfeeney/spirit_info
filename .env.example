# Copy this file to .env and fill it in.
# .env is ignored by git and by Docker builds, so your token stays on your computer.

# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Your Discord user ID (Settings -> Advanced -> Developer Mode, then right-click
# your name -> Copy User ID). Suggestions are DMed to this account, and it is the
# only account allowed to use /reload-data and /ytalerts add/remove/check.
OWNER_ID=

# Optional: a channel that also receives a copy of each suggestion
REVIEW_CHANNEL_ID=

# Optional: comma-separated channel IDs allowed for YouTube announcements
YOUTUBE_ALLOWED_CHANNEL_IDS=
